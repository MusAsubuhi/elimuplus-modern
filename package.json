{
  "name": "elimuplus-modern",
  "version": "0.2.0",
  "private": true,
  "description": "Elimu+ website and platform (static site served from /public, platform under /portal)",
  "scripts": {
    "sync-static": "node scripts/sync-static.mjs",
    "dev": "npm run sync-static && next dev",
    "build": "npm run sync-static && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:test": "node scripts/check-grants.mjs && node scripts/test-rls.mjs && node scripts/test-stories.mjs",
    "db:seed": "node scripts/seed-supabase.mjs",
    "test:auth": "tsx scripts/test-auth-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@types/pg": "^8.23.1",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.50.0",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
