    "0": {
      "name": "Trainee Facilitator",
      "short": "Trainee",
      "depth": "Short observation report. About two minutes. Say what you actually saw.",
      "goes_to": "Your supervisor first, then the founders see a summary.",
      "fields": [
        {
          "key": "day_number",
          "label": "Training day number",
          "type": "number",
          "required": true,
          "core": true
        },
        {
          "key": "headcount",
          "label": "Participants present",
          "type": "number",
          "required": true,
          "core": true
        },
        {
          "key": "engagement",
          "label": "Participant engagement",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Low",
          "maxLabel": "High"
        },
        {
          "key": "surprised_me",
          "label": "What surprised you today, good or bad?",
          "type": "longtext",
          "required": true,
          "help": "This is the most valuable question on the form. Say what you actually saw."
        },
        {
          "key": "venue_ok",
          "label": "Room and materials",
          "type": "choice",
          "required": true,
          "options": [
            "All fine",
            "Minor issue",
            "Serious issue"
          ]
        },
        {
          "key": "venue_note",
          "label": "If there is an issue, what is it?",
          "type": "longtext",
          "required": false
        },
        {
          "key": "concern",
          "label": "Overall concern",
          "type": "choice",
          "required": true,
          "core": true,
          "options": [
            "No concern",
            "Keep an eye on it",
            "Urgent, someone should call me"
          ]
        },
        {
          "key": "concern_note",
          "label": "If there is a concern, what happened? If you need help tomorrow, say what.",
          "type": "longtext",
          "required": false,
          "core": true
        }
      ]
    },
