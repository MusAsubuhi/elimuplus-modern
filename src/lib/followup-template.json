{
  "version": 3,
  "identity": [
    {
      "key": "visited_on",
      "label": "Date of visit",
      "type": "date",
      "required": true
    }
  ],
  "stages": {
    "30": {
      "name": "Day 30",
      "title": "first visit",
      "question": "Is it working, and was the promised support received?",
      "a": [
        {
          "key": "a1_operating",
          "label": "Is the business operating?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "Yes, but reduced",
            "No"
          ]
        },
        {
          "key": "a1_closed_why",
          "label": "If reduced or not operating, the main reason",
          "type": "checkbox",
          "required": false,
          "options": [
            "No capital",
            "No stock",
            "Sickness or family",
            "Lost customers",
            "Moved or relocated",
            "Other"
          ]
        },
        {
          "key": "a4_profit_band",
          "label": "About how much profit did the business make last week?",
          "type": "choice",
          "required": true,
          "help": "Work it out together: sales minus the cost of the stock sold. A range is fine.",
          "options": [
            "No profit, or a loss",
            "Under Ksh 1,000",
            "Ksh 1,000 to 2,000",
            "Ksh 2,000 to 4,000",
            "Over Ksh 4,000"
          ]
        },
        {
          "key": "a4_profit",
          "label": "If she can say a figure, how much was it? (Ksh)",
          "type": "number",
          "required": false
        },
        {
          "key": "a4_compare",
          "label": "Compared with before the training, her weekly income is",
          "type": "choice",
          "required": true,
          "options": [
            "Increasing",
            "About the same",
            "Decreasing"
          ]
        },
        {
          "key": "a4_compare_why",
          "label": "Why did it change? (one line)",
          "type": "text",
          "required": false
        },
        {
          "key": "a3_stock_level",
          "label": "Does she have enough stock or tools to keep trading?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "Partly",
            "No"
          ]
        },
        {
          "key": "a3_missing",
          "label": "If not, what is missing?",
          "type": "text",
          "required": false
        },
        {
          "key": "a3_stock_value",
          "label": "Total business value today, stock plus cash (Ksh)",
          "type": "number",
          "required": true,
          "help": "Count the stock together with her and add the cash in the business."
        },
        {
          "key": "a7_challenges",
          "label": "Challenges (tick all that apply)",
          "type": "checkbox",
          "required": true,
          "options": [
            "Security",
            "Health or family",
            "Debt repayment",
            "Not enough stock or capital",
            "Few customers or low sales",
            "Stock costs rising",
            "Rent, licence or location",
            "Transport",
            "Competition",
            "Other",
            "None at the moment"
          ]
        },
        {
          "key": "a7_growth",
          "label": "Signs of growth (tick all that apply)",
          "type": "checkbox",
          "required": true,
          "options": [
            "More customers",
            "Higher sales",
            "New product added",
            "Stock increased",
            "Saving regularly",
            "Hired help",
            "New location or market",
            "None yet"
          ]
        },
        {
          "key": "a7_risk",
          "label": "Signs of risk (tick all that apply)",
          "type": "checkbox",
          "required": true,
          "help": "A personal safety concern alerts the founders straight away.",
          "options": [
            "Personal safety concern",
            "Thinking of closing",
            "Health or family problem",
            "Debt rising",
            "Stock running low",
            "Sales falling",
            "Business and household money mixed",
            "None"
          ]
        },
        {
          "key": "a5_records",
          "label": "Does she write down sales and spending?",
          "type": "choice",
          "required": true,
          "options": [
            "Daily",
            "Sometimes",
            "Not yet"
          ]
        },
        {
          "key": "a5_pays_self",
          "label": "Does she pay herself a set amount?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "Sometimes",
            "No"
          ]
        },
        {
          "key": "a5_separate",
          "label": "Does she keep business money apart from home money?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "Mostly",
            "No"
          ]
        },
        {
          "key": "a5_used_calc",
          "label": "In the last month, did she use a calculation (cost, price or profit) to make a decision?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "key": "a5_used_calc_what",
          "label": "If yes, what was it?",
          "type": "text",
          "required": false
        },
        {
          "key": "a7_confidence",
          "label": "How confident is she about running this business?",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Not at all",
          "maxLabel": "Very confident"
        }
      ],
      "b": [
        {
          "key": "b1_received",
          "label": "Was the support promised received?",
          "type": "choice",
          "required": true,
          "options": [
            "Fully",
            "Partly",
            "Not yet"
          ]
        },
        {
          "key": "b1_missing",
          "label": "If not, what is missing?",
          "type": "text",
          "required": false
        }
      ],
      "c": [
        {
          "key": "b4_support",
          "label": "Support still needed",
          "type": "checkbox",
          "required": true,
          "options": [
            "Stock or capital",
            "Equipment",
            "Mentoring",
            "Market links",
            "Record-keeping help",
            "Health or family referral",
            "Nothing"
          ]
        },
        {
          "key": "c_action",
          "label": "Action taken at this visit (one line)",
          "type": "text",
          "required": true
        },
        {
          "key": "c_status",
          "label": "Result of this visit: the business is",
          "type": "choice",
          "required": true,
          "options": [
            "Stable",
            "Growing",
            "Struggling",
            "Closed"
          ]
        },
        {
          "key": "c_next",
          "label": "Next action: what needs to happen",
          "type": "text",
          "required": true
        },
        {
          "key": "c_next_who",
          "label": "Next action: who will do it",
          "type": "text",
          "required": true
        },
        {
          "key": "c_next_date",
          "label": "Next action: by when",
          "type": "date",
          "required": true
        },
        {
          "key": "c_impact",
          "label": "What has changed for her income and her family?",
          "type": "longtext",
          "required": false,
          "help": "One or two sentences. This becomes the impact note in the 30-day report."
        }
      ]
    },
