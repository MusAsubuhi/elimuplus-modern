{
  "version": 1,
  "instruments": {
    "baseline": {
      "title": "Elimu+ Day 0 Baseline",
      "description": "Complete this once for every participant in the first two days, in person. It takes about five minutes. It records where they start, so the 30, 60 and 90 day visits can show real change. Name, phone, age and gender are already in the roster, so they are not asked again.",
      "common": [],
      "branch": {
        "label": "Which group is this participant in?",
        "options": [
          {
            "label": "Adult or caregiver",
            "value": "adult",
            "sections": [
              {
                "title": "The business",
                "help": "Work out the money together. Ranges are fine.",
                "fields": [
                  {
                    "key": "business_type",
                    "label": "What is the business?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Sells goods",
                      "Food or drink",
                      "Service, such as a salon or repairs",
                      "Farming or livestock",
                      "Making or crafts",
                      "Other"
                    ]
                  },
                  {
                    "key": "business_stage",
                    "label": "How long has it been running?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Not started yet (an idea)",
                      "Under 6 months",
                      "6 to 12 months",
                      "1 to 3 years",
                      "Over 3 years"
                    ]
                  },
                  {
                    "key": "a1_operating",
                    "label": "Is it operating now?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "Yes, but reduced",
                      "No"
                    ]
                  },
                  {
                    "key": "a4_profit_band",
                    "label": "About how much profit did the business make last week?",
                    "type": "choice",
                    "required": true,
                    "help": "Work it out together: sales minus the cost of the stock sold. A range is fine.",
                    "options": [
                      "No profit, or a loss",
                      "Under Ksh 1,000",
                      "Ksh 1,000 to 2,000",
                      "Ksh 2,000 to 4,000",
                      "Over Ksh 4,000"
                    ]
                  },
                  {
                    "key": "a4_profit",
                    "label": "If she can say a figure, how much was it? (Ksh)",
                    "type": "number",
                    "required": false
                  },
                  {
                    "key": "a3_stock_level",
                    "label": "Does she have enough stock or tools to keep trading?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "Partly",
                      "No"
                    ]
                  },
                  {
                    "key": "a3_stock_value",
                    "label": "Total business value today, stock plus cash (Ksh)",
                    "type": "number",
                    "required": true,
                    "help": "Count the stock together with her and add the cash in the business."
                  },
                  {
                    "key": "a7_category",
                    "label": "What is her biggest challenge right now?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Security",
                      "Health or family",
                      "Debt repayment",
                      "Not enough stock or capital",
                      "Few customers or low sales",
                      "Stock costs rising",
                      "Rent, licence or location",
                      "Transport",
                      "Competition",
                      "Other"
                    ]
                  },
                  {
                    "key": "a5_records",
                    "label": "Does she write down sales and spending?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Daily",
                      "Sometimes",
                      "Not yet"
                    ]
                  },
                  {
                    "key": "a5_pays_self",
                    "label": "Does she pay herself a set amount?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "Sometimes",
                      "No"
                    ]
                  },
                  {
                    "key": "a5_separate",
                    "label": "Does she keep business money apart from home money?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "Mostly",
                      "No"
                    ]
                  },
                  {
                    "key": "a5_used_calc",
                    "label": "In the last month, did she use a calculation (cost, price or profit) to make a decision?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "No"
                    ]
                  },
                  {
                    "key": "a5_used_calc_what",
                    "label": "If yes, what was it?",
                    "type": "text",
                    "required": false
                  },
                  {
                    "key": "confidence",
                    "label": "How confident is she about running this business?",
                    "type": "scale",
                    "required": true,
                    "min": 1,
                    "max": 5,
                    "minLabel": "Not at all",
                    "maxLabel": "Very confident"
                  }
                ]
              }
            ]
          },
          {
            "label": "Youth",
            "value": "youth",
            "sections": [
              {
                "title": "The young person",
                "help": "Let them answer in their own words. Ranges are fine.",
                "fields": [
                  {
                    "key": "education_status",
                    "label": "What is the young person's situation now?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "In school",
                      "Out of school and not working",
                      "Doing casual work",
                      "Working in a job",
                      "Running a small business",
                      "Other"
                    ]
                  },
                  {
                    "key": "hoped_path",
                    "label": "What do they want most from the next year?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "A job",
                      "My own business",
                      "Both",
                      "To study",
                      "Not sure"
                    ]
                  },
                  {
                    "key": "skills_have",
                    "label": "Which skills do they already have?",
                    "type": "checkbox",
                    "required": true,
                    "options": [
                      "Selling",
                      "Handling money",
                      "A trade or craft",
                      "Computer or phone skills",
                      "Cooking",
                      "Farming",
                      "Talking to customers",
                      "None yet",
                      "Other"
                    ]
                  },
                  {
                    "key": "a7_category",
                    "label": "What stops them most from moving forward?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "No money",
                      "No experience",
                      "No contacts",
                      "No skills certificate",
                      "No idea where to start",
                      "Family or health",
                      "Other"
                    ]
                  },
                  {
                    "key": "prior_work",
                    "label": "Work experience so far",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "None",
                      "Informal or casual",
                      "Formal job"
                    ]
                  },
                  {
                    "key": "earning_range",
                    "label": "Money earned in the last 30 days",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Nothing yet",
                      "Under Ksh 1,000",
                      "Ksh 1,000 to 3,000",
                      "Ksh 3,000 to 6,000",
                      "Over Ksh 6,000"
                    ]
                  },
                  {
                    "key": "has_cv",
                    "label": "Do they have a CV?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "No"
                    ]
                  },
                  {
                    "key": "applied_recently",
                    "label": "Have they applied for work or started something in the last three months?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "No"
                    ]
                  },
                  {
                    "key": "can_explain",
                    "label": "Can they explain their skill to an employer or customer in a few sentences?",
                    "type": "choice",
                    "required": true,
                    "options": [
                      "Yes",
                      "A bit",
                      "Not yet"
                    ]
                  },
                  {
                    "key": "confidence",
                    "label": "How confident are they about their next step?",
                    "type": "scale",
                    "required": true,
                    "min": 1,
                    "max": 5,
                    "minLabel": "Not at all",
                    "maxLabel": "Very confident"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "learning": {
      "title": "Elimu+ Learning Check",
      "description": "Six short questions and one confidence rating, taken on the first day and again on the last day. It is not a pass or fail test. It shows us what the training changes. Please answer alone and do not look at anyone else's paper.",
      "common": [
        {
          "key": "stage",
          "label": "When is this check being taken?",
          "type": "choice",
          "required": true,
          "options": [
            "Start of the programme",
            "End of the programme"
          ],
          "help": "Everyone does the same short check on the first and the last day. It is not marked against them; it shows what the training changes."
        },
        {
          "key": "q1",
          "label": "A woman sells 20 mandazi at KES 10 each. The flour, oil and charcoal for them cost KES 120. What is her profit?",
          "type": "choice",
          "required": true,
          "options": [
            "KES 200",
            "KES 120",
            "KES 80",
            "KES 20"
          ],
          "correct": "KES 80"
        },
        {
          "key": "q2",
          "label": "Which of these is a fixed cost for a small shop (one you pay whether you sell or not)?",
          "type": "choice",
          "required": true,
          "options": [
            "Rent for the stall",
            "Stock bought each week",
            "Transport for each delivery",
            "Packaging for each sale"
          ],
          "correct": "Rent for the stall"
        },
        {
          "key": "q3",
          "label": "What does 'break-even' mean?",
          "type": "choice",
          "required": true,
          "options": [
            "Sales equal total costs, so there is no profit and no loss",
            "The day with the highest sales",
            "All the stock is sold",
            "The business has borrowed money"
          ],
          "correct": "Sales equal total costs, so there is no profit and no loss"
        },
        {
          "key": "q4",
          "label": "A juice seller sells a bottle for KES 70. The fruit, bottle and ice for that one bottle cost KES 45. How much does each bottle contribute towards the rent and the profit?",
          "type": "choice",
          "required": true,
          "options": [
            "KES 115",
            "KES 70",
            "KES 45",
            "KES 25"
          ],
          "correct": "KES 25"
        },
        {
          "key": "q5",
          "label": "Before starting a business, the best first step is to:",
          "type": "choice",
          "required": true,
          "options": [
            "Buy as much stock as possible",
            "Copy the neighbour's business",
            "Ask possible customers what problem they want solved",
            "Borrow a large loan"
          ],
          "correct": "Ask possible customers what problem they want solved"
        },
        {
          "key": "q6",
          "label": "A woman buys a KES 6,000 blender once for her juice stall. If she closes the business, she cannot get that money back. This is called a:",
          "type": "choice",
          "required": true,
          "options": [
            "Sunk cost",
            "Variable cost",
            "Sale",
            "Saving"
          ],
          "correct": "Sunk cost"
        },
        {
          "key": "confidence",
          "label": "How confident are you that you could work out the profit of a small business? (1 = not at all, 5 = very)",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Not at all",
          "maxLabel": "Very"
        }
      ],
      "self": true
    },
    "exit": {
      "title": "Elimu+ End of Training Feedback",
      "description": "Completed on the last training day. Six short questions. Your honest answers help us improve the programme.",
      "common": [
        {
          "key": "rating",
          "label": "Overall, how was the training?",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Poor",
          "maxLabel": "Excellent"
        },
        {
          "key": "clarity",
          "label": "How clear was the facilitator?",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Not clear",
          "maxLabel": "Very clear"
        },
        {
          "key": "most_useful",
          "label": "Which topic helped you most?",
          "type": "choice",
          "required": true,
          "options": [
            "Session 1: Introduction to employability and entrepreneurship",
            "Session 2: Designing your product or personal value proposition",
            "Session 3: Defining your target audience",
            "Session 4: Designing operations",
            "Session 5: Pricing, compensation and workplace culture",
            "Session 6: Hiring, teamwork and relationships"
          ]
        },
        {
          "key": "change_suggestion",
          "label": "What is one thing we should improve?",
          "type": "text",
          "required": true
        },
        {
          "key": "recommend",
          "label": "Would you recommend this training to a friend?",
          "type": "choice",
          "required": true,
          "options": [
            "Yes",
            "Not sure",
            "No"
          ]
        },
        {
          "key": "confidence",
          "label": "How confident do you feel about starting or improving your business or job search?",
          "type": "scale",
          "required": true,
          "min": 1,
          "max": 5,
          "minLabel": "Not at all",
          "maxLabel": "Very confident"
        },
        {
          "key": "concern",
          "label": "Did anything happen during the training that was unsafe or unfair?",
          "type": "choice",
          "required": true,
          "options": [
            "No",
            "Yes"
          ]
        },
        {
          "key": "concern_note",
          "label": "If yes, tell us what you are comfortable sharing",
          "type": "longtext",
          "required": false
        }
      ],
      "self": true
    },
