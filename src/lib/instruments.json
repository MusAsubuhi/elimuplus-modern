    {
     "key": "gender",
     "label": "Gender",
     "type": "choice",
     "required": true,
     "options": [
      "Female",
      "Male",
      "Other",
      "Prefer not to say"
     ]
    },
    {
     "key": "birth_year",
     "label": "Year of birth",
     "type": "number",
     "required": true,
     "help": "Four digits, for example 1988."
    },
    {
     "key": "education",
     "label": "Highest level of schooling",
     "type": "choice",
     "options": [
      "No formal schooling",
      "Some primary",
      "Completed primary (KCPE)",
      "Some secondary",
      "Completed secondary (KCSE)",
      "TVET or vocational certificate",
      "Diploma",
      "Bachelor's degree",
      "Postgraduate"
     ]
    },
    {
     "key": "disability",
     "label": "Does the participant live with a disability?",
     "type": "choice",
     "options": [
      "No",
      "Yes",
      "Prefer not to say"
     ],
     "help": "Ask privately. This helps us plan access and report fairly."
    },
    {
     "key": "partner_ref",
