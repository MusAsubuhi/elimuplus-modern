  "learning": {
   "title": "Elimu+ Learning Check",
   "description": "Six short questions and one confidence rating, taken on the first day and again on the last day. It is not a pass or fail test. It shows us what the training changes. Please answer alone and do not look at anyone else's paper.",
   "common": [
    {
     "key": "stage",
     "label": "When is this check being taken?",
     "type": "choice",
     "required": true,
     "options": [
      "Start of the programme",
      "End of the programme"
     ],
     "help": "Everyone does the same short check on the first and the last day. It is not marked against them; it shows what the training changes."
    },
    {
     "key": "q1",
     "label": "A woman sells 20 mandazi at KES 10 each. The flour, oil and charcoal for them cost KES 120. What is her profit?",
     "type": "choice",
     "required": true,
     "options": [
      "KES 200",
      "KES 120",
      "KES 80",
      "KES 20"
     ],
     "correct": "KES 80"
    },
    {
     "key": "q2",
     "label": "Which of these is a fixed cost for a small shop (one you pay whether you sell or not)?",
     "type": "choice",
     "required": true,
     "options": [
      "Rent for the stall",
      "Stock bought each week",
      "Transport for each delivery",
      "Packaging for each sale"
     ],
     "correct": "Rent for the stall"
    },
    {
     "key": "q3",
     "label": "What does 'break-even' mean?",
     "type": "choice",
     "required": true,
     "options": [
      "Sales equal total costs, so there is no profit and no loss",
      "The day with the highest sales",
      "All the stock is sold",
      "The business has borrowed money"
     ],
     "correct": "Sales equal total costs, so there is no profit and no loss"
    },
    {
     "key": "q4",
     "label": "A juice seller sells a bottle for KES 70. The fruit, bottle and ice for that one bottle cost KES 45. How much does each bottle contribute towards the rent and the profit?",
     "type": "choice",
     "required": true,
     "options": [
      "KES 115",
      "KES 70",
      "KES 45",
      "KES 25"
     ],
     "correct": "KES 25"
    },
    {
     "key": "q5",
     "label": "Before starting a business, the best first step is to:",
     "type": "choice",
     "required": true,
     "options": [
      "Buy as much stock as possible",
      "Copy the neighbour's business",
      "Ask possible customers what problem they want solved",
      "Borrow a large loan"
     ],
     "correct": "Ask possible customers what problem they want solved"
    },
    {
     "key": "q6",
     "label": "A woman buys a KES 6,000 blender once for her juice stall. If she closes the business, she cannot get that money back. This is called a:",
     "type": "choice",
     "required": true,
     "options": [
      "Sunk cost",
      "Variable cost",
      "Sale",
      "Saving"
     ],
     "correct": "Sunk cost"
    },
    {
     "key": "confidence",
     "label": "How confident are you that you could work out the profit of a small business? (1 = not at all, 5 = very)",
     "type": "scale",
     "required": true,
     "min": 1,
     "max": 5,
     "minLabel": "Not at all",
     "maxLabel": "Very"
    }
   ],
   "self": true
  },
